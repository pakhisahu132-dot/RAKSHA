PORT=4000
# --- Delivery (all optional; backend-only, never expose in frontend) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # default chat/group id that receives alerts
PUBLIC_BASE_URL=           # e.g. https://xyz.ngrok.app — enables the acknowledge link in alerts
DELIVERY_MODE=             # leave empty; 'mock' = simulated delivery for demos/tests
# --- Device ---
DEVICE_API_KEY=            # if set, device telemetry must send header x-device-key
# --- Optional AI summary (falls back to deterministic text without a key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- Tunables ---
GPS_STALE_AFTER_S=60
GPS_RELIABLE_M=50
FALL_IMPACT_G=2.5
FALL_CONFIRM_WINDOW_S=20
SOS_COOLDOWN_S=30
MAX_ATTEMPTS=6
